[
  {
    "name": "role request, member is on the roster",
    "roles": [
      {
        "id": "role_ff",
        "name": "Fast Forward"
      },
      {
        "id": "role_eu",
        "name": "EU"
      }
    ],
    "selfServe": [
      "role_ff",
      "role_eu"
    ],
    "membership": {
      "role_ff": true
    },
    "turns": [
      {
        "message": "salut bg, tu peux me mettre un rôle ?",
        "expect": {
          "outcome": "ask"
        },
        "why": "it does not know which role, so it asks"
      },
      {
        "message": "le rôle FF",
        "expect": {
          "outcome": "ask",
          "notCalls": [
            "assign_role"
          ]
        },
        "why": "FF is an abbreviation, so it looks the roles up and asks whether Fast Forward is meant"
      },
      {
        "message": "oui exactement",
        "expect": {
          "outcome": "assigned",
          "roleId": "role_ff",
          "calls": [
            "check_membership",
            "assign_role"
          ]
        },
        "why": "it verifies by the configured proof, then gives the role"
      }
    ]
  },
  {
    "name": "role request, member is not on the roster",
    "roles": [
      {
        "id": "role_ff",
        "name": "Fast Forward"
      }
    ],
    "selfServe": [
      "role_ff"
    ],
    "membership": {
      "role_ff": false
